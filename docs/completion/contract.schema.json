        "api-content",
        "none"
      ]
    },
    "publicationWritePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtimeProtectedPaths": {
      "type": "array",
      "minItems": 1,
