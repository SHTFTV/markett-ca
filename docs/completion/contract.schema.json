                "domain",
                "editorial",
                "desktop",
                "phone",
                "sot",
                "bot",
                "connections",
                "unattended",
                "state",
                "recovery",
                "alerts",
                "google",
                "bing",
                "ingestion",
                "generation",
                "media",
                "publishing",
                "forms",
                "indexing",
                "launch"
