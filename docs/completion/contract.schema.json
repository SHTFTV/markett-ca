  "$id": "https://markett-ca.vercel.app/schemas/completion-contract-v2",
  "title": "MarkEtt staged operating contract v2",
  "type": "object",
  "required": [
    "standardVersion",
    "site",
    "repository",
    "sourceCommit",
    "sotRef",
    "requirementsRef",
    "promisedFlows",
    "requirements",
