              "type": "boolean"
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            },
            "maxAgeHours": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 168
