    "workUnits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "kind",
          "sourceRef"
        ]
      }
    },
    "pageQualityVersion": {
      "const": 1
    },
    "pageInventoryRef": {
      "type": "string",
      "minLength": 1
    },
    "pageInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "pageType"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "pageType": {
            "enum": [
              "home",
              "article",
              "editorial-page",
              "utility",
              "privacy",
              "form"
            ]
          },
          "exemptionReason": {
            "type": "string"
          },
          "formatExemption": {
            "type": "object",
            "required": [
              "kind",
              "approved",
              "sourceRef",
              "reason"
            ],
            "properties": {
              "kind": {
                "const": "mining-one-minute-brief"
              },
              "approved": {
                "const": true
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
