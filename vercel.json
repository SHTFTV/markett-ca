{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "outputDirectory": ".",
  "functions": {
    "api/operations-stream.js": {
      "maxDuration": 300
    },
    "api/operations-events.js": {
      "maxDuration": 30
    },
    "api/operations-state.js": {
      "maxDuration": 30
    },
    "api/operations-audit.js": {
      "maxDuration": 300
    },
    "api/mining-publisher-recovery.js": {
      "maxDuration": 60
    },
    "api/operations-monitor.js": {
      "maxDuration": 120
    },
    "api/command-center-status.js": {
      "maxDuration": 60
    },
    "api/vercel-inventory.js": {
      "maxDuration": 60
    },
    "api/portfolio-rollout.js": {
      "maxDuration": 300
    },
    "api/portfolio-rollout-watchdog.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/command",
      "destination": "/command-center"
    }
  ],
  "crons": [
    {
      "path": "/api/vercel-inventory",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/portfolio-rollout",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/portfolio-rollout-watchdog",
      "schedule": "3-58/5 * * * *"
    }
  ]
}
